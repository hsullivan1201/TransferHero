# WMATA API Key (required)
WMATA_API_KEY=your_api_key_here

# Server port (optional, default 3001)
PORT=3001

# Environment (optional, default development)
NODE_ENV=development

# CORS origin (optional, default *)
CORS_ORIGIN=http://localhost:5173

# Public origin used in messaging-preview URLs (required in production)
PUBLIC_BASE_URL=http://localhost:3001

# Stable HMAC secret for signed trip links (required in production, 32+ characters)
SHARE_TOKEN_SECRET=replace_with_a_long_random_secret

# Optional SQLite path for durable short links. Railway volumes are auto-detected.
# SHARE_LINK_DB_PATH=./data/transferhero-share-links.sqlite

# GTFS refresh cron schedule (optional, default "0 3 * * *" = 3 AM daily)
GTFS_REFRESH_CRON=0 3 * * *
